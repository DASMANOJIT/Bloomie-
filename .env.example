INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Facebook Login user token for the Facebook Page-linked Instagram professional
# account. Required for /{ig-user-id}/collaborative_media; never expose client-side.
INSTAGRAM_FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_FACEBOOK_USER_ID=your_facebook_page_linked_instagram_user_id

# One-time inputs for `npm run instagram:auth -- --write`. The Facebook User token
# must be freshly authorized for this app with the Bloomie Page selected.
INSTAGRAM_FACEBOOK_PAGE_ID=
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Required in production for canonical URLs, Open Graph URLs, sitemap, and structured data.
# Set this to the verified public HTTPS origin without a path.
SITE_URL=https://your-verified-production-domain.example
